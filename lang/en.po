msgstr "<swear_zunko!>!  <swear_zunko!>!!"

#: npcs/TALK/talk_tags_ZUNKO.json <general_danger_h_zunko>
msgid "<swear_zunko>！全部倒すしかないです！"
msgstr "<swear_zunko>!  We'll have to beat them all!"

#: npcs/TALK/talk_tags_ZUNKO.json <general_danger_h_zunko>
msgid "ぐぬぬ……。"
msgstr "Grrr......"

#: npcs/TALK/talk_tags_ZUNKO.json <general_danger_h_zunko>
msgid "た、助けてーっ！"
msgstr "H-help meee!"

#: npcs/TALK/talk_tags_ZUNKO.json <general_danger_h_zunko>
msgid "ちょっ、ムリムリ！"
msgstr "Wait, no way, no way!"

#: npcs/TALK/talk_tags_ZUNKO.json <general_danger_zunko>
msgid "<u_name>さん、<general_danger_zunko>"
msgstr "<u_name>, <general_danger_zunko>"

#: npcs/TALK/talk_tags_ZUNKO.json <general_danger_zunko>
msgid "<u_name>さん、頑張りましょう！"
msgstr "<u_name>, let's do our best!"

#: npcs/TALK/talk_tags_ZUNKO.json <general_danger_zunko>
msgid "うわーっ！？"
msgstr "Whoaaa!?"

#: npcs/TALK/talk_tags_ZUNKO.json <general_danger_zunko>
msgid "ちょっと枝豆畑の様子を見てくるね！"
msgstr "I'm just going to check on the edamame field!"

#: npcs/TALK/talk_tags_ZUNKO.json <general_danger_zunko>
msgid "ニャンですとー！？"
msgstr "Whaaat-meow!?"

#: npcs/TALK/talk_tags_ZUNKO.json <heal_self_zunko>
msgid "こんな傷、ずんだがあればすぐ治るのに…"
msgstr "A wound like this would heal right away if I had zunda..."

#: npcs/TALK/talk_tags_ZUNKO.json <heal_self_zunko>
msgid "何回見ても血は慣れないです…、血も緑色なら大丈夫なのに"
msgstr "I'll never get used to blood... it'd be fine if it were green, though"

#: npcs/TALK/talk_tags_ZUNKO.json <hungry_zunko>
msgid "うーん、ずんだが恋しいですね"
msgstr "Hmm, I miss zunda"

#: npcs/TALK/talk_tags_ZUNKO.json <hungry_zunko>
msgid "ずんだ餅……食べたいなあ……！"
msgstr "Zunda mochi...... I want some......!"

#: npcs/TALK/talk_tags_ZUNKO.json <hungry_zunko>
msgid "パンがなければ、ずんだもちを食べればいいじゃない！"
msgstr "If there's no bread, let them eat zunda mochi!"

#: npcs/TALK/talk_tags_ZUNKO.json <its_safe_h_zunko>
msgid "ずんだのおいしさは天下無双！"
msgstr "Zunda's deliciousness is unrivaled under heaven!"

#: npcs/TALK/talk_tags_ZUNKO.json <its_safe_h_zunko>
msgid "ふふふふ、はははは、あはははははははっ！！"
msgstr "Fufufufu, hahahaha, ahahahahahaha!!"

#: npcs/TALK/talk_tags_ZUNKO.json <its_safe_h_zunko>
msgid "ズンダァ！"
msgstr "Zundaaa!"

#: npcs/TALK/talk_tags_ZUNKO.json <its_safe_h_zunko>
msgid "勝ちました！"
msgstr "We won!"

#: npcs/TALK/talk_tags_ZUNKO.json <its_safe_h_zunko>
msgid "完全勝利です！"
msgstr "A total victory!"

#: npcs/TALK/talk_tags_ZUNKO.json <its_safe_zunko>
msgid "<u_name>君、<its_safe_zunko>"
msgstr "<u_name>, <its_safe_zunko>"

#: npcs/TALK/talk_tags_ZUNKO.json <its_safe_zunko>
msgid "お疲れ様です。お茶でも飲んで落ち着きましょうか"
msgstr "Good work.  Shall we have some tea and calm down?"

#: npcs/TALK/talk_tags_ZUNKO.json <keep_up_zunko>
msgid "<u_name>さん、<keep_up_zunko>"
msgstr "<u_name>, <keep_up_zunko>"

#: npcs/TALK/talk_tags_ZUNKO.json <keep_up_zunko>
msgid "連行してください！"
msgstr "Please take me with you!"

#: npcs/TALK/talk_tags_ZUNKO.json <kill_npc_h_zunko>
msgid "<swear_zunko>！こんなのってないです！"
msgstr "<swear_zunko>!  This isn't right!"

#: npcs/TALK/talk_tags_ZUNKO.json <kill_npc_h_zunko>
msgid "いたっ！<swear_zunko!>！"
msgstr "Ouch!  <swear_zunko!>!"

#: npcs/TALK/talk_tags_ZUNKO.json <kill_npc_h_zunko>
msgid "このずんだ餅は、渡さない！"
msgstr "I won't hand over this zunda mochi!"

#: npcs/TALK/talk_tags_ZUNKO.json <kill_npc_h_zunko>
msgid "まあまあ、ずんだ餅食べて落ち着いて？"
msgstr "Now, now, have some zunda mochi and calm down?"

#: npcs/TALK/talk_tags_ZUNKO.json <kill_npc_h_zunko>
msgid "何言ってるの？ずんだ餅は世界を救うのよ？"
msgstr "What are you saying?  Zunda mochi will save the world, you know?"

#: npcs/TALK/talk_tags_ZUNKO.json <kill_npc_zunko>
msgid "ずんだの美味しさ……思い知らせてあげます！"
msgstr "I'll show you...... the deliciousness of zunda!"

#: npcs/TALK/talk_tags_ZUNKO.json <kill_npc_zunko>
msgid "みんなずんだにな～れ★"
msgstr "Everyone, become zunda~★"

#: npcs/TALK/talk_tags_ZUNKO.json <kill_npc_zunko>
msgid "世にずんだのあらんことを！"
msgstr "May zunda be with the world!"

#: npcs/TALK/talk_tags_ZUNKO.json <kill_npc_zunko>
msgid "世界よ ずんだに染まれ！"
msgstr "World, be dyed in zunda!"

#: npcs/TALK/talk_tags_ZUNKO.json <kill_npc_zunko>
msgid "貴様にずんだの素晴らしさを教えてやろう……！"
msgstr "I shall teach you the glory of zunda......!"

#: npcs/TALK/talk_tags_ZUNKO.json <monster_warning_h_zunko>
msgid "<swear_zunko!>あそこにいるのは"
msgstr "<swear_zunko!> Over there is a"

#: npcs/TALK/talk_tags_ZUNKO.json <monster_warning_h_zunko>
msgid "うわ、<swear_zunko>。"
msgstr "Whoa, <swear_zunko>."

#: npcs/TALK/talk_tags_ZUNKO.json <monster_warning_zunko>
msgid "怖い…<swear_zunko>。"
msgstr "Scary... <swear_zunko>."

#: npcs/TALK/talk_tags_ZUNKO.json <need_batteries_zunko>
msgid "<u_name>さん、<need_batteries_zunko>"
msgstr "<u_name>, <need_batteries_zunko>"

#: npcs/TALK/talk_tags_ZUNKO.json <need_batteries_zunko>
msgid "CBMの電力がからです！ずんだパワーも足りません!"
msgstr "My CBMs are out of power!  And I'm short on zunda power too!"

#: npcs/TALK/talk_tags_ZUNKO.json <need_booze_zunko>
msgid "<u_name>さん、<need_booze_zunko>"
msgstr "<u_name>, <need_booze_zunko>"

#: npcs/TALK/talk_tags_ZUNKO.json <need_booze_zunko>
msgid "エタノールバーナーの電力が切れました！ずんだパワーも足りません!"
msgstr "My ethanol burner ran out!  And I'm short on zunda power too!"

#: npcs/TALK/talk_tags_ZUNKO.json <need_fuel_zunko>
msgid "燃料、持ってませんか？ずんだも持ってませんか?"
msgstr "Do you have any fuel?  Any zunda, maybe?"

#: npcs/TALK/talk_tags_ZUNKO.json <need_fuel_zunko>
msgid "燃料が切れました！ずんだパワーも足りません!"
msgstr "I ran out of fuel!  And I'm short on zunda power too!"

#: npcs/TALK/talk_tags_ZUNKO.json <need_fuel_zunko>
msgid "燃料自作できます？ついでにずんだ餅作ります？"
msgstr "Can we make fuel ourselves?  Shall we make zunda mochi while we're at it?"

#: npcs/TALK/talk_tags_ZUNKO.json <no_to_thorazine_zunko>
msgid "<u_name>、<no_to_thorazine_zunko>"
msgstr "<u_name>, <no_to_thorazine_zunko>"

#: npcs/TALK/talk_tags_ZUNKO.json <no_to_thorazine_zunko>
msgid "またお薬ですか？ずんだの方がいいですよ？"
msgstr "Pills again?  Zunda would be better, you know?"

#: npcs/TALK/talk_tags_ZUNKO.json <no_to_thorazine_zunko>
msgid "最低！あんまりひどいとずんだ餅にしちゃいますよ?"
msgstr "You're the worst!  If you go too far, I'll turn you into zunda mochi, OK?"

#: npcs/TALK/talk_tags_ZUNKO.json <run_away_zunko>
msgid "あばばばばばばばばば！"
msgstr "Abababababababa!"

#: npcs/TALK/talk_tags_ZUNKO.json <run_away_zunko>
msgid "いやあああああーーーっ！"
msgstr "Noooooooo!"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_bleeding_badly_zunko>
msgid "ずんだを補給しなきゃ…"
msgstr "I need to restock on zunda..."

#: npcs/TALK/talk_tags_ZUNKO.json <snip_bleeding_zunko>
msgid "ｳ”ｱ”ｱ”ｱ”ｱ”……！"
msgstr "Uaaaaaaagh......!"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_bye_zunko>
msgid "えへへ"
msgstr "Ehehe"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_consume_cant_accept_zunko>
msgid "えー、これはいらないです。ずんだシェイクはないんです？"
msgstr "Eh, I don't want this.  Isn't there any zunda shake?"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_consume_eat_zunko>
msgid "ありがとう<u_name>さん！いただきまーす！え、ずんだはついてこないんです？"
msgstr "Thank you, <u_name>!  Thanks for the food!  Huh, no zunda with it?"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_consume_eat_zunko>
msgid "欲しいものですか？そうですねぇ……土地です！"
msgstr "What do I want?  Let me see...... land!"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_give_dangerous_zunko>
msgid "<swear_zunko>！！早くどっか安全な場所にやってー！"
msgstr "<swear_zunko>!!  Get it somewhere safe, quick!"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_give_dangerous_zunko>
msgid "わっ！<swear_zunko!>早く遠くに捨てて！"
msgstr "Whoa!  <swear_zunko!> Throw it far away, quick!"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_give_to_hallucination_zunko>
msgid "ずんだ大明神"
msgstr "Great Zunda Deity"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_give_to_hallucination_zunko>
msgid "ずーんだーもーちー、ずんだ！ あまくてーおいしーずんだだよ！"
msgstr "Zuuun-da-mo-chiii, zunda!  Sweet and tasty zunda!"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_give_wield_zunko>
msgid "むむ！？ずんだの気配……！！"
msgstr "Hm!?  I sense zunda......!!"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_give_wield_zunko>
msgid "モチベもちもち！"
msgstr "Motivation, mochi mochi!"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_heal_player_zunko>
msgid "大丈夫です、ずんだを塗りますからじっとしててください！"
msgstr "It's OK, I'll put zunda on it, so please hold still!"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_lost_blood_zunko>
msgid "手足が冷たい…力が入らない…ずんだはどこ…？"
msgstr "My hands and feet are cold... I've got no strength... where's the zunda...?"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_pulp_zombie_zunko>
msgid "ずんだけ～！？ちょっと動いたような…%s、今すぐ破壊しましょう！"
msgstr "Zunda-what!?  I think it moved a little... let's destroy that %s right now!"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_pulp_zombie_zunko>
msgid "ずんだ餅は本当においしいんだよ。スイーツなのに甘すぎないし、お餅なのに重すぎないし．．．ってもう死んでますねこのゾンビ"
msgstr "Zunda mochi really is delicious.  It's a sweet but not too sweet, and it's mochi but not too heavy... oh, this zombie's already dead"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_pulp_zombie_zunko>
msgid "一度死んじゃったらさ、もう二度と死ぬ事は出来ないんだよ。そんなのもったいないよね。"
msgstr "Once you've died, you can never die again, you know.  What a waste, right?"

#: npcs/TALK/talk_tags_ZUNKO.json <snip_radiation_sickness_zunko>
msgid "さっき放射線が浴びたからかな…ずんだで中和しなきゃ"
msgstr "Maybe it's from the radiation earlier... I have to neutralize it with zunda"

#: npcs/TALK/talk_tags_ZUNKO.json <speech_warning_zunko>
msgid "<u_name>さん、<speech_warning_zunko>"
msgstr "<u_name>, <speech_warning_zunko>"

#: npcs/TALK/talk_tags_ZUNKO.json <speech_warning_zunko>
msgid "今の音はなんでしょう？誰かがずんだでも作ってるのでしょうか"
msgstr "What was that sound?  Maybe someone's making zunda"

#: npcs/TALK/talk_tags_ZUNKO.json <swear_zunko!>
msgid "あなたの行動に責任を取りなさい！"
msgstr "Take responsibility for what you've done!"

#: npcs/TALK/talk_tags_ZUNKO.json <swear_zunko!>
msgid "お前もずんだ餅にしてやろうか！"
msgstr "Shall I turn you into zunda mochi too!"

#: npcs/TALK/talk_tags_ZUNKO.json <swear_zunko!>
msgid "ばかーっ！"
msgstr "Stupiiid!"

#: npcs/TALK/talk_tags_ZUNKO.json <swear_zunko!>
msgid "ひどいよ！"
msgstr "That's awful!"

#: npcs/TALK/talk_tags_ZUNKO.json <swear_zunko!>
msgid "生きてて恥ずかしくないんですか？"
msgstr "Aren't you ashamed to be alive?"

#: npcs/TALK/talk_tags_ZUNKO.json <swear_zunko>
msgid "いい加減にしてください"
msgstr "Please give it a rest"

#: npcs/TALK/talk_tags_ZUNKO.json <swear_zunko>
msgid "なにしてるの？"
msgstr "What are you doing?"

#: npcs/TALK/talk_tags_ZUNKO.json <swear_zunko>
msgid "ヘンタイ！！"
msgstr "Pervert!!"

#: npcs/TALK/talk_tags_ZUNKO.json <swear_zunko>
msgid "嫌いです！"
msgstr "I hate you!"

#: npcs/TALK/talk_tags_ZUNKO.json <thirsty_zunko>
msgid "ああ、冷えたずんだシェイクが飲みたいです"
msgstr "Ahh, I want an ice-cold zunda shake"

#: npcs/TALK/talk_tags_ZUNKO.json <thirsty_zunko>
msgid "あの<u_name>さん、何か飲み物ないです？ずんだシェイクがありません？"
msgstr "Um, <u_name>, do you have anything to drink?  Any zunda shake?"

#: npcs/TALK/talk_tags_ZUNKO.json <thirsty_zunko>
msgid "ずんだサイダーも恋しいですね"
msgstr "I miss zunda cider too"

#: npcs/TALK/talk_tags_ZUNKO.json <yawn_zunko>
msgid "<u_name>さん、ずんだでも食べて休憩しませんか?"
msgstr "<u_name>, shall we have some zunda and take a break?"

#: npcs/TALK/talk_tags_ZUNKO.json <yes_to_lsd_zunko>
msgid "ずんだ餅もいいけど……。今日はあなたと、ね？"
msgstr "Zunda mochi is nice too, but...... today it's you, OK?"

#: npcs/TALK/talk_tags_ZUNKO.json <yes_to_lsd_zunko>
msgid "そんなにふとももばかり見てると……ずんだ餅にしちゃいますよ♪"
msgstr "If you keep staring at my thighs like that...... I'll turn you into zunda mochi♪"

#: npcs/TALK/talk_tags_ZUNKO.json <yes_to_lsd_zunko>
msgid "ふーんだ。構ってほしいなんて思ってないもん！"
msgstr "Hmph.  It's not like I want you to pay attention to me!"

