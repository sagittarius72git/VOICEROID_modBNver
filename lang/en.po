msgstr "Yeah, I think I can do that"

#: npcs/TALK/talk_tags_MAKI.json <acknowledged_maki>
msgid "はいよー"
msgstr "Okay~"

#: npcs/TALK/talk_tags_MAKI.json <acknowledged_maki>
msgid "べーっ！…あっ、嘘嘘、ちゃんとやるよ？"
msgstr "Bleh!  ...Oh, kidding, kidding, I'll do it properly, OK?"

#: npcs/TALK/talk_tags_MAKI.json <acknowledged_maki>
msgid "りょーかい"
msgstr "Roger"

#: npcs/TALK/talk_tags_MAKI.json <acknowledged_maki>
msgid "わかったー！"
msgstr "Got it!"

#: npcs/TALK/talk_tags_MAKI.json <acknowledged_maki>
msgid "オッケー！"
msgstr "OK!"

#: npcs/TALK/talk_tags_MAKI.json <acknowledged_maki>
