#: npcs/TALK/talk_tags_MAKI.json <combat_noise_warning_maki>
msgid "何かが戦ってるみたい"
msgstr "Sounds like something's fighting"

#: npcs/TALK/talk_tags_MAKI.json <combat_noise_warning_maki>
msgid "何かが戦ってるみたい！"
msgstr "Sounds like something's fighting!"

#: npcs/TALK/talk_tags_MAKI.json <combat_noise_warning_maki>
msgid "何か起こってるみたい"
msgstr "Something's going on"

#: npcs/TALK/talk_tags_MAKI.json <danger_close_distance_maki>
msgid "<u_name>君、逃げて！"
msgstr "<u_name>, run!"

#: npcs/TALK/talk_tags_MAKI.json <danger_close_distance_maki>
