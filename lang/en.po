msgstr "Roger that, ma'am!  ...just kidding"

#: npcs/TALK/talk_tags_MAKI.json <acknowledged_maki>
msgid "任せて！"
msgstr "Leave it to me!"

#: npcs/TALK/talk_tags_MAKI.json <acknowledged_maki>
msgid "私にまかせてっ"
msgstr "Leave it to me!"

#: npcs/TALK/talk_tags_MAKI.json <camp_food_thanks_maki>
msgid "*もぐもぐ*<camp_food_thanks_maki>"
msgstr "*munch munch* <camp_food_thanks_maki>"

#: npcs/TALK/talk_tags_MAKI.json <camp_food_thanks_maki>
