msgstr "<swear_maki>!  <swear_maki>!  I'm not gonna die here!"

#: npcs/TALK/talk_tags_MAKI.json <cant_flee_maki>
msgid "こっちくるなー！"
msgstr "Stay awaaay!"

#: npcs/TALK/talk_tags_MAKI.json <cant_flee_maki>
msgid "こっち来るなーー！"
msgstr "Don't come heeere!"

#: npcs/TALK/talk_tags_MAKI.json <cant_flee_maki>
