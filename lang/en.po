msgstr "I can't be picky in a situation like this, can I"

#: npcs/TALK/talk_tags_MAKI.json <camp_food_thanks_maki>
msgid "美味しいねー"
msgstr "It's tasty~"

#: npcs/TALK/talk_tags_MAKI.json <camp_larder_empty_maki>
msgid "<u_name>君<u_name>君、<camp_larder_empty_maki>"
msgstr "<u_name>, <u_name>, <camp_larder_empty_maki>"

#: npcs/TALK/talk_tags_MAKI.json <camp_larder_empty_maki>
msgid "からっぽだ！"
msgstr "It's empty!"

#: npcs/TALK/talk_tags_MAKI.json <camp_larder_empty_maki>
msgid "ごはんないよー！"
msgstr "There's no fooood!"

#: npcs/TALK/talk_tags_MAKI.json <camp_larder_empty_maki>
msgid "ねえ、<u_name>君。もう食べ物が残ってないみたいだよ？"
msgstr "Hey, <u_name>.  Looks like there's no food left?"

#: npcs/TALK/talk_tags_MAKI.json <camp_larder_empty_maki>
msgid "私、今日まだ食べてなんだけどー？"
msgstr "I haven't eaten yet today, you know?"

#: npcs/TALK/talk_tags_MAKI.json <camp_water_thanks_maki>
